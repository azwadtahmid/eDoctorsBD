# PostgreSQL connection string.
# Easiest free options: https://neon.tech or https://supabase.com (both have a free tier).
DATABASE_URL="postgresql://user:password@localhost:5432/edoctorsbd"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-string-here" # e.g. `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"

# Used to build absolute redirect URLs for the payment gateway
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SSLCommerz SANDBOX credentials (free, no business docs needed).
# Sign up: https://developer.sslcommerz.com/registration/
# Leave SSLCOMMERZ_BASE_URL as-is — it points at the sandbox host,
# so no real money ever moves.
SSLCOMMERZ_STORE_ID="your_sandbox_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_sandbox_store_password"
SSLCOMMERZ_BASE_URL="https://sandbox.sslcommerz.com"

# --- Demo only ---
# If no SSLCommerz credentials are set, bookings skip payment and go straight
# to the doctor's review queue. That happens automatically in development.
# On a deployed (production) build it requires this explicit opt-in.
# Leave this unset for anything that handles real money.
DEMO_ALLOW_PAYMENT_BYPASS="false"

# --- Database seeding ---
# The seed script creates an ADMIN account. In development it falls back to
# admin@example.com / password123. A production seed REFUSES to run unless you
# set a real password here.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
