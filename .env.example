# PostgreSQL connection string.
# Easiest free options: https://neon.tech or https://supabase.com (both have a free tier).
DATABASE_URL="postgresql://user:password@localhost:5432/edoctorsbd"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-string-here" # e.g. `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"

# Used to build absolute redirect URLs for the payment gateway
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SSLCommerz SANDBOX credentials (free, no business docs needed).
# Sign up: https://developer.sslcommerz.com/registration/
# Leave SSLCOMMERZ_BASE_URL as-is — it points at the sandbox host,
# so no real money ever moves.
SSLCOMMERZ_STORE_ID="your_sandbox_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_sandbox_store_password"
SSLCOMMERZ_BASE_URL="https://sandbox.sslcommerz.com"
